# ============================================================
# 环境变量参考模板(复制为 .env 后按需填写,严禁提交真实密钥)
# 注意:Spring Boot 不会自动读取 .env,请将变量配置到
#   - IDEA: Run/Debug Configurations → Environment variables
#   - PowerShell: $env:变量名 = "值"(临时会话)
# 或使用 dotenv 类工具加载。
# ============================================================

# ---- 必配 ----
# 通义千问 API Key(https://bailian.console.aliyun.com)
DASHSCOPE_API_KEY=sk-your-api-key-here

# MySQL 账号密码
MYSQL_USER=xxkfz
MYSQL_PASSWORD=your-mysql-password

# Redis 密码(本地无密码可留空)
REDIS_PASSWORD=

# MySQL root 密码(Docker 部署时必配,用于初始化容器)
MYSQL_ROOT_PASSWORD=your-mysql-root-password

# ---- 可选(不设置时使用 application.yml / docker-compose.yml 中的默认值) ----
# SERVER_PORT=8083
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DB=travel_planner
# REDIS_HOST=localhost
# REDIS_PORT=6379
# DASHSCOPE_MODEL=qwen-plus
# TRAVEL_AI_ENABLED=true

# ---- Docker Compose 部署专用(可选) ----
# 宿主机映射端口:避免与本机已装的 MySQL/Redis 冲突
# MYSQL_EXPOSE_PORT=3307
# REDIS_EXPOSE_PORT=6379
# JVM 参数
# JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC -Dfile.encoding=UTF-8
